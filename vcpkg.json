{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "maa-meta",
  "version": "2.7.1",
  "description": "meta manifest that tracks dependencies for MaaFramework",
  "homepage": "https://github.com/MaaXYZ/MaaDeps",
  "license": null,
  "dependencies": [
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "eigen",
        "jpeg",
        "png",
        "calib3d",
        "world"
      ]
    },
    {
      "$FIXME": "default-features: false for opencv doesn't get propagated to opencv4",
      "name": "opencv4",
      "default-features": false,
      "features": [
        "eigen",
        "jpeg",
        "png",
        "calib3d",
        "world"
      ]
    },
    {
      "name": "maa-onnxruntime",
      "platform": "windows & x64",
      "features": [
        "directml",
        "webgpu"
      ]
    },
    {
      "name": "maa-onnxruntime",
      "platform": "windows & arm64",
      "features": [
        "directml",
        "webgpu"
      ]
    },
    {
      "name": "maa-onnxruntime",
      "platform": "linux & x64",
      "features": [
        "webgpu"
      ]
    },
    {
      "name": "maa-onnxruntime",
      "platform": "linux & arm64",
      "features": [
        "webgpu"
      ]
    },
    {
      "name": "maa-onnxruntime",
      "platform": "osx",
      "features": [
        "webgpu"
      ]
    },
    "maa-fastdeploy",
    {
      "name": "ncnn",
      "platform": "android"
    },
    {
      "name": "polyclipping",
      "platform": "android"
    },
    "zlib",
    "boost-asio",
    "boost-core",
    "boost-dll",
    {
      "name": "boost-process",
      "platform": "!android"
    },
    "boost-uuid",
    "cppzmq",
    {
      "name": "vgamepad-bin",
      "platform": "windows & (x64 | x86)"
    },
    {
      "name": "wayland",
      "platform": "linux",
      "features": [
        "force-build"
      ]
    },
    {
      "name": "dbus",
      "platform": "linux",
      "default-features": false
    }
  ],
  "features": {
    "openvino": {
      "description": "Build the optional Intel OpenVINO acceleration pack (CPU/NPU)",
      "dependencies": [
        {
          "name": "maa-onnxruntime",
          "platform": "windows & x64",
          "features": [
            "openvino"
          ]
        },
        {
          "name": "maa-onnxruntime",
          "platform": "linux & x64",
          "features": [
            "openvino"
          ]
        }
      ]
    }
  }
}